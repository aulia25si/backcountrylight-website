// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
  STAFF
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  addresses     Address[]
  memberships   Membership[]
  membershipOrders MembershipOrder[]
  auditLogs     MembershipAuditLog[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  image       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logo        String?
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id             String   @id @default(cuid())
  sku            String?  @unique
  name           String
  slug           String   @unique
  description    String   @db.Text
  price          Int
  stock          Int      @default(0)
  image          String
  images         String[] @default([]) // Extra images
  specifications Json?    // Flexible key-value pairs
  isFeatured     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  
  brandId        String
  brand          Brand    @relation(fields: [brandId], references: [id])

  orderItems     OrderItem[]
  options        ProductOption[]
  variants       ProductVariant[]
}

model Order {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  status          OrderStatus   @default(PENDING)
  totalAmount     Int
  shippingAddress Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Payment Status & Method
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   String        @default("MANUAL_BANK_TRANSFER")
  paidAt          DateTime?

  // Courier & Tracking (Dummy/Editable di Admin)
  courier         String?       @default("jne")
  courierService  String?       @default("REG")
  trackingNumber  String?

  // Manual Transfer & Payment Proof Details
  paymentProofUrl String?
  senderName      String?
  senderBank      String?
  transferAmount  Int?
  transferDate    DateTime?
  verifiedAt      DateTime?
  verifiedBy      String?

  items           OrderItem[]
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  REJECTED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Int     // Snapshot of final price at the time of purchase
  originalPrice Int?  // Snapshot of original unit price before discount
  discountPct   Int?  // Snapshot of membership discount % applied
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  street      String
  city        String
  postalCode  String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductOption {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  values      String[]
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  sku         String?  @unique
  price       Int?
  stock       Int      @default(0)
  options     Json
  imageUrl    String?
  
  orderItems  OrderItem[]
}

enum MembershipTierType {
  SILVER
  GOLD
  PLATINUM
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
}

model MembershipTier {
  id           String             @id @default(cuid())
  type         MembershipTierType @unique
  name         String
  discountPct  Int                // e.g. 10 for Silver, 15 for Gold, 20 for Platinum
  price        Int                // Biaya membership dlm IDR
  durationDays Int                // Masa berlaku (e.g. 365)
  description  String?            @db.Text
  benefits     String[]           @default([])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  memberships  Membership[]
  orders       MembershipOrder[]
}

model Membership {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierType     MembershipTierType
  tier         MembershipTier     @relation(fields: [tierType], references: [type])
  status       MembershipStatus   @default(PENDING)
  discountPct  Int                // Snapshot discount %
  startDate    DateTime?
  expiresAt    DateTime?
  
  businessName String?
  businessType String?            // e.g. Reseller / Dropshipper
  phoneNumber  String?

  adminNotes   String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  orders       MembershipOrder[]
  auditLogs    MembershipAuditLog[]

  @@index([userId, status])
}

model MembershipOrder {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipId    String?
  membership      Membership?        @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  tierType        MembershipTierType
  tier            MembershipTier     @relation(fields: [tierType], references: [type])
  
  amount          Int                // Harga membership saat order dibuat
  durationDays    Int                // Snapshot durasi
  isRenewal       Boolean            @default(false)

  // Payment Status & Method (Manual Bank Transfer)
  paymentStatus   PaymentStatus      @default(UNPAID)
  paymentMethod   String             @default("MANUAL_BANK_TRANSFER")
  paidAt          DateTime?

  // Bukti Transfer
  paymentProofUrl String?
  senderName      String?
  senderBank      String?
  transferAmount  Int?
  transferDate    DateTime?
  verifiedAt      DateTime?
  verifiedBy      String?
  rejectionReason String?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  auditLogs       MembershipAuditLog[]

  @@index([userId, paymentStatus])
}

model MembershipAuditLog {
  id                String           @id @default(cuid())
  membershipId      String?
  membership        Membership?      @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  membershipOrderId String?
  membershipOrder   MembershipOrder? @relation(fields: [membershipOrderId], references: [id], onDelete: SetNull)
  adminId           String?
  admin             User?            @relation(fields: [adminId], references: [id], onDelete: SetNull)
  
  action            String           // e.g. "MANUAL_ASSIGN", "APPROVE_PAYMENT", "REJECT_PAYMENT", "CHANGE_TIER", "EXTEND_EXPIRY", "REVOKE"
  details           String?          @db.Text
  createdAt         DateTime         @default(now())
}

